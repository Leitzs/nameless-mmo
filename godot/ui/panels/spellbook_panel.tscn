[gd_scene format=3]

[ext_resource type="Script" path="res://ui/panels/spellbook_panel.gd" id="1_spellbook"]

[node name="SpellbookPanel" type="PanelContainer"]
custom_minimum_size = Vector2(0, 240)
size_flags_vertical = 3
theme_type_variation = &"ToolPanel"
script = ExtResource("1_spellbook")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Content"]
layout_mode = 2

[node name="Title" type="Label" parent="Content/Header"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
theme_override_font_sizes/font_size = 22
text = "SPELLBOOK"

[node name="ClassName" type="Label" parent="Content/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 16
horizontal_alignment = 2

[node name="Close" type="Button" parent="Content/Header"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"SmallButton"
tooltip_text = "Close (P)"
text = "×"

[node name="Weapon" type="RichTextLabel" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 1
theme_override_font_sizes/normal_font_size = 14
theme_override_font_sizes/bold_font_size = 15
bbcode_enabled = true
fit_content = true
scroll_active = false
autowrap_mode = 3

[node name="Line" type="ColorRect" parent="Content"]
custom_minimum_size = Vector2(0, 1)
layout_mode = 2
mouse_filter = 2
color = Color(1, 0.916, 0.626, 0.3)

[node name="Scroll" type="ScrollContainer" parent="Content"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Entries" type="VBoxContainer" parent="Content/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14
