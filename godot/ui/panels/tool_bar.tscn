[gd_scene format=3]

[ext_resource type="Script" path="res://ui/panels/tool_bar.gd" id="1_bar"]

[node name="ToolBar" type="PanelContainer"]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -380.0
offset_top = 8.0
offset_right = 380.0
offset_bottom = 48.0
grow_horizontal = 2
theme_type_variation = &"HudPanel"
script = ExtResource("1_bar")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6
alignment = 1

[node name="Help" type="Button" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"SmallButton"
toggle_mode = true
text = "F1  Controls"

[node name="Spellbook" type="Button" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"SmallButton"
toggle_mode = true
text = "P  Spellbook"

[node name="Inventory" type="Button" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"SmallButton"
toggle_mode = true
text = "I  Inventory"

[node name="Balance" type="Button" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"SmallButton"
toggle_mode = true
text = "F4  Balance"

[node name="Hint" type="Label" parent="Row"]
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 13
text = "Esc frees the mouse  ·  F6 hides this bar"
