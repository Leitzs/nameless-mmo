[gd_scene format=3]

[ext_resource type="Script" path="res://ui/panels/balance_panel.gd" id="1_balance"]

[node name="BalancePanel" type="PanelContainer"]
custom_minimum_size = Vector2(0, 360)
size_flags_vertical = 3
size_flags_stretch_ratio = 1.7
theme_type_variation = &"ToolPanel"
script = ExtResource("1_balance")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Content"]
layout_mode = 2

[node name="Title" type="Label" parent="Content/Header"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
theme_override_font_sizes/font_size = 22
text = "BALANCE"

[node name="Changes" type="Label" parent="Content/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 15
horizontal_alignment = 2

[node name="Close" type="Button" parent="Content/Header"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"SmallButton"
tooltip_text = "Close (F4)"
text = "×"

[node name="ClassRow" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ClassLabel" type="Label" parent="Content/ClassRow"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "Class"

[node name="ClassOption" type="OptionButton" parent="Content/ClassRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SmallButton"
tooltip_text = "The class whose numbers are shown. It follows your class until you pick another one."

[node name="Tabs" type="TabContainer" parent="Content"]
layout_mode = 2
size_flags_vertical = 3
current_tab = 0

[node name="Spells" type="ScrollContainer" parent="Content/Tabs"]
layout_mode = 2
horizontal_scroll_mode = 0
metadata/_tab_index = 0

[node name="SpellsList" type="VBoxContainer" parent="Content/Tabs/Spells"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="Class" type="ScrollContainer" parent="Content/Tabs"]
visible = false
layout_mode = 2
horizontal_scroll_mode = 0
metadata/_tab_index = 1

[node name="ClassList" type="VBoxContainer" parent="Content/Tabs/Class"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="Weapons" type="ScrollContainer" parent="Content/Tabs"]
visible = false
layout_mode = 2
horizontal_scroll_mode = 0
metadata/_tab_index = 2

[node name="WeaponsList" type="VBoxContainer" parent="Content/Tabs/Weapons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="Global" type="ScrollContainer" parent="Content/Tabs"]
visible = false
layout_mode = 2
horizontal_scroll_mode = 0
metadata/_tab_index = 3

[node name="GlobalList" type="VBoxContainer" parent="Content/Tabs/Global"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="HostNote" type="Label" parent="Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.916, 0.626, 1)
theme_override_font_sizes/font_size = 14
text = "Only the host can change the balance. You are seeing the host's values."
autowrap_mode = 3

[node name="Footer" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Save" type="Button" parent="Content/Footer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SmallButton"
tooltip_text = "Write the changed values to user://balance.cfg"
text = "Save"

[node name="Load" type="Button" parent="Content/Footer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SmallButton"
tooltip_text = "Replace the current changes with the saved ones"
text = "Load"

[node name="ResetClass" type="Button" parent="Content/Footer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SmallButton"
tooltip_text = "Every number of this class, its abilities and weapons back to the default"
text = "Reset class"

[node name="ResetAll" type="Button" parent="Content/Footer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SmallButton"
tooltip_text = "Every changed value back to the default"
text = "Reset all"

[node name="Status" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
autowrap_mode = 3
