[gd_scene format=3]

[ext_resource type="Script" path="res://ui/menus/class_picker.gd" id="1_picker"]
[ext_resource type="PackedScene" path="res://ui/menus/class_grid.tscn" id="2_grid"]

[node name="ClassPicker" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_picker")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.7)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(720, 0)
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 30
text = "CHOOSE YOUR CLASS"
horizontal_alignment = 1

[node name="ClassGrid" parent="Center/Panel/Content" instance=ExtResource("2_grid")]
unique_name_in_owner = true
layout_mode = 2
columns = 4

[node name="Hint" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "Changing class respawns your character. F3 or Esc closes this."
horizontal_alignment = 1
